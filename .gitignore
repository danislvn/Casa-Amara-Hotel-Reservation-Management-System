data/backups/
*.sql.bak
data/email_logs.json
data/email_logs*.json
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# SSL / TLS Keys & Certificates
*.pem
*.key
*.cert
*.crt

# Node & Package Managers
node_modules/

